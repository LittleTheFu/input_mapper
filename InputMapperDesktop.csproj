<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InputMapperDesktop</AssemblyName>
    <RootNamespace>InputMapperDesktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\keyboard-hands-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\mouse-hand*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
